#!/usr/bin/env python3
"""Operate a private workspace, Linux execution endpoint, or managed SSH transport.

init prepares a new installation; start/status/stop/restart operate only its exact Harness launch.
access/open operate workspace browser access; enrollment exports endpoint metadata. No credential values are printed.
"""
import argparse
import fcntl
import hashlib
import html
import json
import os
from pathlib import Path
import re
import shutil
import signal
import socket
import stat
import subprocess
import sys
import time
import urllib.parse
import urllib.request
import uuid
import webbrowser
import agentic_endpoint
import agentic_service
import agentic_delegation
import agentic_transport
from contextlib import contextmanager

CHECKOUT = Path(__file__).resolve().parent.parent
HARNESS_VERSION = '0.2.1-rc.3'
PROFILE_NAME = re.compile(r'^[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}$')


def private_directory(path):
    if path.is_symlink():
        raise RuntimeError('Installation directories must not be symbolic links.')
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = path.stat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise RuntimeError('Installation directory must be owned by you with mode 0700: ' + str(path))


def read_json(path):
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077 or info.st_size > 65536:
        raise RuntimeError('Installation metadata must be an owner-only regular file: ' + str(path))
    return json.loads(path.read_text())


def atomic(path, content):
    if path.is_symlink():
        raise RuntimeError('Refusing a symbolic-link control file: ' + str(path))
    temporary = path.with_name('.' + path.name + '.' + uuid.uuid4().hex)
    try:
        with temporary.open('x', encoding='utf8') as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        temporary.replace(path)
        directory = os.open(str(path.parent), os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        temporary.unlink(missing_ok=True)


def save(path, value):
    atomic(path, json.dumps(value, indent=2) + '\n')


def private_log(path):
    descriptor = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
    info = os.fstat(descriptor)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        os.close(descriptor)
        raise RuntimeError('Logs must be owner-only regular files.')
    return os.fdopen(descriptor, 'ab')


@contextmanager
def operation(root):
    with private_log(root / 'operation.lock') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise agentic_service.Busy('Another operation is already controlling this installation.') from None
        yield


def environment(root, installation=None):
    if installation and installation['role'] == 'transport':
        return {'PATH': os.defpath, 'LANG': 'C', 'LC_ALL': 'C'}
    return {**os.environ, 'DSH_HOME': str(root / 'home')}


def command(root, installation):
    if installation['role'] == 'transport':
        return agentic_transport.command(root, installation)
    return [installation['cli'], '--profile', installation['profile'], '--patch', str(root / 'launch.json'), '--no-open']


def manifest(root, ready=True):
    value = read_json(root / 'installation.json')
    if isinstance(value, dict) and value.get('role') == 'transport':
        return agentic_transport.manifest(root, value, ready)
    if not isinstance(value, dict) or value.get('schema') != 1 or value.get('root') != str(root) or value.get('version') != HARNESS_VERSION:
        raise RuntimeError('Unsupported or relocated installation metadata. Use the documented recovery process.')
    if not PROFILE_NAME.fullmatch(value.get('profile', '')) or not isinstance(value.get('port'), int) or not 1024 <= value['port'] <= 65535:
        raise RuntimeError('Invalid installation profile or port.')
    if not all(isinstance(value.get(key), str) and Path(value[key]).is_absolute() and '\n' not in value[key] and '\r' not in value[key] for key in ('checkout', 'cli')):
        raise RuntimeError('Invalid installation paths.')
    if ready and value.get('phase') != 'ready':
        raise RuntimeError('Installation is incomplete; rerun init to resume it.')
    value.setdefault('role', 'workspace')
    if value['role'] not in ('workspace', 'endpoint'):
        raise RuntimeError('Unknown installation role.')
    if value['role'] == 'endpoint':
        if not isinstance(value.get('endpointConfig'), dict):
            raise RuntimeError('Endpoint installation has no configuration.')
        if ('endpointId' in value) != ('adminHash' in value):
            raise RuntimeError('Endpoint installation identity is incomplete.')
        if 'endpointId' in value and (str(uuid.UUID(value['endpointId'])) != value['endpointId'] or not re.fullmatch(r'[a-f0-9]{64}', value['adminHash'])):
            raise RuntimeError('Invalid endpoint installation identity.')
    if value.get('delegation') is not None:
        agentic_delegation.validate(value, agentic_service.service_identity(root)['label'])
    return value


def initialize(root, args):
    path = root / 'installation.json'
    existing_role = manifest(root, ready=False)['role'] if path.exists() else None
    if existing_role and args.role and existing_role != args.role:
        raise RuntimeError('The selected installation has a different role; it was not changed.')
    if (args.role or existing_role) == 'transport':
        return agentic_transport.initialize(root, args, sys.modules[__name__])
    if args.transport_config:
        raise RuntimeError('--transport-config requires --role transport.')
    if path.exists():
        value = manifest(root, ready=False)
        requested = {'profile': args.profile, 'port': args.port, 'role': args.role,
                     'checkout': str(Path(args.checkout).expanduser().resolve()) if args.checkout else None,
                     'cli': str(Path(args.dsh).expanduser().resolve()) if args.dsh else None}
        if any(item is not None and item != value[key] for key, item in requested.items()):
            raise RuntimeError('Existing installation differs from the requested settings; it was not changed.')
        if args.endpoint_config:
            requested_config = read_json(Path(args.endpoint_config).expanduser())
            if args.service_resources and value.get('delegation'):
                if 'resources' in requested_config:
                    raise RuntimeError('Explicit resources cannot be combined with service resource budgets.')
                requested_config = {**requested_config, 'resources': {'cgroupRoot': value['delegation']['workerRoot'], **read_json(Path(args.service_resources).expanduser())}}
            if agentic_endpoint.configuration(requested_config) != value.get('endpointConfig'):
                raise RuntimeError('Existing endpoint configuration differs; it was not changed.')
        if args.service_resources:
            budgets = read_json(Path(args.service_resources).expanduser())
            if not value.get('delegation') or budgets != {key: value['endpointConfig']['resources'][key] for key in ('pool', 'command')}:
                raise RuntimeError('Existing service resource settings differ; they were not changed.')
        if value.get('phase') == 'ready':
            print(json.dumps({'installed': True, 'directory': str(root), 'profile': value['profile']}))
            return 0
    else:
        if any(item.name != 'operation.lock' for item in root.iterdir()):
            raise RuntimeError('Refusing to initialize a nonempty directory without installation metadata.')
        checkout = Path(args.checkout or CHECKOUT).expanduser().resolve()
        role = args.role or 'workspace'
        package = json.loads((checkout / 'package.json').read_text())
        required = ('index.js', 'client.js') + (('remote-endpoint.js', 'remote-fs-worker.js', 'remote-command-worker.js', 'remote-resource-worker.js', 'verification-snapshot-worker.js') if role == 'endpoint' else ())
        if package.get('name') != 'dsh-superagent' or not all((checkout / 'lib' / name).is_file() for name in required):
            raise RuntimeError('Select a built dsh-superagent checkout; run pnpm install --frozen-lockfile and pnpm build there first.')
        if role == 'endpoint':
            agentic_endpoint.require_host()
        elif args.endpoint_config or args.service_resources:
            raise RuntimeError('--endpoint-config and --service-resources require --role endpoint.')
        profile, port = args.profile or ('agentic-endpoint' if role == 'endpoint' else 'agentic-os'), args.port or (3084 if role == 'endpoint' else 3083)
        if not PROFILE_NAME.fullmatch(profile) or not 1024 <= port <= 65535:
            raise RuntimeError('Use a valid profile name and a port between 1024 and 65535.')
        cli = str(Path(args.dsh).expanduser().resolve()) if args.dsh else str(root / 'runtime' / 'node_modules' / '.bin' / 'dsh')
        value = {'schema': 1, 'root': str(root), 'phase': 'preparing', 'profile': profile, 'port': port,
                 'checkout': str(checkout), 'cli': cli, 'version': HARNESS_VERSION, 'externalCli': bool(args.dsh), 'profileIntent': False, 'role': role}
        if role == 'endpoint':
            config = read_json(Path(args.endpoint_config).expanduser()) if args.endpoint_config else {}
            if args.service_resources:
                budgets = read_json(Path(args.service_resources).expanduser())
                if not isinstance(config, dict) or 'resources' in config or not isinstance(budgets, dict) or set(budgets) != {'pool', 'command'}:
                    raise RuntimeError('--service-resources requires pool/command budgets and cannot replace explicit endpoint resources.')
                value['delegation'] = agentic_delegation.plan(root, agentic_service.service_identity(root)['label'])
                config = {**config, 'resources': {'cgroupRoot': value['delegation']['workerRoot'], **budgets}}
            value['endpointConfig'] = agentic_endpoint.configuration(config)
        save(path, value)
    if value['role'] == 'endpoint':
        agentic_endpoint.require_host()
        agentic_endpoint.validate_directory(root, value['endpointConfig'])
        private_directory(root / 'workspaces')
    for name in ('home', 'state', 'sessions', 'logs'):
        private_directory(root / name)
    with private_log(root / 'install.log') as log:
        def run(argv):
            result = subprocess.run(argv, cwd=value['checkout'], env=environment(root), stdin=subprocess.DEVNULL, stdout=log, stderr=log)
            if result.returncode:
                raise RuntimeError('Installation command failed; private details are in ' + str(root / 'install.log'))
        if not value['externalCli'] and not Path(value['cli']).exists():
            npm = shutil.which('npm')
            if not npm:
                raise RuntimeError('Node.js and npm must be installed before init can install the pinned Harness.')
            private_directory(root / 'runtime')
            run([npm, 'install', '--prefix', str(root / 'runtime'), '--no-audit', '--no-fund', '@deepseek-ai/dsh@' + HARNESS_VERSION])
        version = subprocess.run([value['cli'], '--version'], env=environment(root), stdin=subprocess.DEVNULL, capture_output=True, text=True)
        if version.returncode or version.stdout.strip() != HARNESS_VERSION:
            raise RuntimeError('The selected Harness CLI must be version ' + HARNESS_VERSION)
        # Use a canonical executable path for exact process matching, including paths with spaces.
        value['cli'] = str(Path(value['cli']).resolve())
        profile = root / 'home' / 'profiles' / value['profile']
        if profile.exists() and not value['profileIntent']:
            raise RuntimeError('An unclaimed Harness profile already exists; it was not replaced.')
        value['profileIntent'] = True
        save(path, value)
        if not profile.exists():
            run([value['cli'], '--profile', value['profile'], '--from-default-profile', 'web', '--dump-config'])
        if not all((profile / name).is_file() for name in ('package.json', 'cordis.yml', 'cordis.patch.yml')):
            raise RuntimeError('Profile creation was interrupted with incomplete files; inspect the private install log. Existing files were preserved.')
        run([value['cli'], 'plugin', '--profile', value['profile'], 'add', 'link:' + value['checkout']])
    launch = agentic_endpoint.launch_patch(root, value) if value['role'] == 'endpoint' else [
        {'id': 'webserver', 'config': {'host': '127.0.0.1', 'port': value['port']}},
        {'id': 'dsh-superagent', 'config': {'stateDir': str(root / 'state'), 'executionMode': 'local'}},
        {'id': 'dsh-superagent-github', 'disabled': True}, {'id': 'dsh-superagent-feishu', 'disabled': True},
        {'id': 'session-persistence-jsonl', 'config': {'root': str(root / 'sessions'), 'compression': 'none'}},
        {'id': 'attachment-local', 'config': {'dshHome': str(root / 'home')}},
        {'id': 'session-title-llm', 'disabled': True},
    ]
    target = root / 'launch.json'
    if target.exists() and read_json(target) != launch:
        raise RuntimeError('The generated launch patch was changed; existing configuration was preserved.')
    save(target, launch)
    value['launchHash'] = hashlib.sha256(target.read_bytes()).hexdigest()
    value['phase'] = 'ready'
    save(path, value)
    print(json.dumps({'installed': True, 'directory': str(root), 'profile': value['profile'], 'version': HARNESS_VERSION,
                      'role': value['role'], 'next': 'Run service-install, then check status and enrollment.' if value.get('delegation') else 'Start the endpoint, then use enrollment to export private connection metadata.' if value['role'] == 'endpoint' else 'Configure a provider privately in Harness Settings → Models after starting.'}))
    return 0


def processes(root, installation):
    expected = ' '.join(command(root, installation))
    result = subprocess.run(['ps', '-ww', '-U', str(os.getuid()), '-o', 'pid=,lstart=,args='],
                            env={**os.environ, 'LC_ALL': 'C'}, capture_output=True, text=True, check=True)
    matches = []
    for line in result.stdout.splitlines():
        parts = line.split(None, 6)
        if len(parts) != 7 or not parts[0].isdigit():
            continue
        if parts[6] == expected or parts[6].endswith(' ' + expected):
            matches.append({'pid': int(parts[0]), 'started': ' '.join(parts[1:6])})
    return matches


def single(root, installation):
    values = processes(root, installation)
    if len(values) > 1:
        raise RuntimeError('Multiple processes match this installation; refusing to choose one.')
    return values[0] if values else None


def health(root, installation):
    if installation['role'] == 'transport':
        return agentic_transport.health(root, installation, NoRedirect)
    if installation['role'] == 'endpoint':
        return agentic_endpoint.health(root, installation, NoRedirect)
    url = 'http://127.0.0.1:' + str(installation['port']) + '/orchestrator/api/state'
    try:
        request = urllib.request.Request(url, headers={'x-orchestrator-request': '1'})
        with urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect()).open(request, timeout=2) as response:
            content = response.read(262145)
        if len(content) > 262144:
            return None
        value = json.loads(content)
        if value.get('setup', {}).get('machine', {}).get('stateDir') != str(root / 'state'):
            return None
        if not isinstance(value.get('health'), dict) or not all(isinstance(entry, dict) for entry in value['health'].values()):
            return None
        problem = value['setup'].get('problem')
        if problem is not None and not isinstance(problem, dict):
            return None
        return value
    except (OSError, ValueError, AttributeError):
        return None


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, file, code, message, headers, url):
        return None


def status(root, installation):
    process = single(root, installation)
    state = health(root, installation) if process else None
    ready = bool(state and state.get('health', {}).get('runtime', {}).get('state') in ('ready', 'paused')
                 and (installation['role'] != 'endpoint' or installation.get('endpointId')))
    errors = [name for name, entry in (state or {}).get('health', {}).items() if entry.get('state') == 'error']
    setup = (state or {}).get('setup', {}).get('problem')
    result = {'directory': str(root), 'profile': installation['profile'], 'role': installation['role'], 'process': process,
              'url': 'http://127.0.0.1:' + str(installation['port']), 'ready': ready,
              'manuallyStopped': (root / 'manually-stopped').exists(), 'errors': errors,
              'setup': {'code': setup.get('code'), 'place': setup.get('place')} if setup else None}
    if installation['role'] in ('endpoint', 'transport'):
        result['endpoint'] = (state or {}).get('endpoint')
    if installation['role'] == 'transport':
        result['transport'] = {'kind': 'ssh', 'host': installation['transport']['host'], 'remotePort': installation['transport']['remotePort']}
    result['supervision'] = agentic_service.snapshot(root, sys.modules[__name__])
    if installation.get('delegation'):
        result['delegation'] = installation['delegation']
        result['serviceStart'] = agentic_service.start_request(root, sys.modules[__name__])
    print(json.dumps(result))
    return 1 if not ready else 3 if setup else 2 if errors else 0


def launch(root, installation, args):
    if getattr(args, 'shutting_down', lambda: False)():
        raise RuntimeError('Supervisor shutdown requested; launch skipped.')
    if args.respect_stop and (root / 'manually-stopped').exists():
        print('Intentional stop is active; automatic recovery skipped.')
        return 0
    if installation.get('delegation'):
        agentic_delegation.process_inside(installation['delegation'], {'pid': os.getpid()})
    if installation['role'] == 'transport':
        agentic_transport.validate(root, installation)
    else:
        read_json(root / 'launch.json')
    if installation['role'] == 'endpoint':
        agentic_endpoint.require_host()
        agentic_endpoint.validate_directory(root, installation['endpointConfig'])
        private_directory(root / 'workspaces')
        if read_json(root / 'launch.json') != agentic_endpoint.launch_patch(root, installation):
            raise RuntimeError('Endpoint launch configuration differs from its installation metadata.')
    for name in (('logs',) if installation['role'] == 'transport' else ('home', 'state', 'sessions', 'logs')):
        private_directory(root / name)
    if installation['role'] != 'transport' and hashlib.sha256((root / 'launch.json').read_bytes()).hexdigest() != installation.get('launchHash'):
        raise RuntimeError('The generated launch patch was changed; restore the reviewed patch before starting.')
    process = single(root, installation)
    if installation.get('delegation'):
        agentic_delegation.process_inside(installation['delegation'], process)
    child = None
    if not process:
        # Port conflicts are not evidence that this installation is already running.
        with socket.socket() as probe:
            try:
                # Match Harness/Node's restart behavior without enabling shared listeners.
                probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                probe.bind(('127.0.0.1', installation['port']))
                probe.listen(1)
            except OSError:
                raise RuntimeError('The configured loopback port is in use; no process was started or stopped.') from None
        log_name = time.strftime('app-%Y%m%d-%H%M%S-') + uuid.uuid4().hex + '.log'
        save(root / 'run.json', {'log': log_name, 'phase': 'launching'})
        with private_log(root / 'logs' / log_name) as output:
            child = subprocess.Popen(command(root, installation), cwd=installation['checkout'], env=environment(root, installation),
                                     stdin=subprocess.DEVNULL, stdout=output, stderr=subprocess.STDOUT,
                                     start_new_session=True, close_fds=True)
        print('Private log: ' + str(root / 'logs' / log_name), flush=True)
        logs = sorted((p for p in (root / 'logs').iterdir() if re.fullmatch(r'app-\d{8}-\d{6}-[a-f0-9]{32}\.log', p.name)), key=lambda p: p.name)
        for old in logs[:-20]:
            if old.name != log_name:
                old.unlink()
    (root / 'manually-stopped').unlink(missing_ok=True)
    deadline = time.monotonic() + args.timeout
    while time.monotonic() < deadline:
        if getattr(args, 'shutting_down', lambda: False)():
            raise RuntimeError('Supervisor shutdown requested during startup.')
        process = single(root, installation)
        if process:
            save(root / 'process.json', process)
            current = health(root, installation)
            if current and current.get('health', {}).get('runtime', {}).get('state') in ('ready', 'paused'):
                if installation['role'] == 'endpoint' and 'endpointId' not in installation:
                    installation['endpointId'] = current['endpoint']['id']
                    installation['adminHash'] = current['adminHash']
                    save(root / 'installation.json', installation)
                if child:
                    run = read_json(root / 'run.json')
                    save(root / 'run.json', {**run, 'phase': 'started', 'process': process})
                return status(root, installation)
        if child and child.poll() is not None:
            raise RuntimeError(('SSH' if installation['role'] == 'transport' else 'Harness') + ' exited during startup; inspect the private log. Installation data was retained.')
        time.sleep(0.2)
    raise RuntimeError('Startup health check timed out; any running process was left intact. Check status before retrying.')


def stop(root, installation, args, intentional=True):
    process = single(root, installation)
    if intentional:
        atomic(root / 'manually-stopped', time.strftime('%Y-%m-%dT%H:%M:%S%z') + ' ' + str(uuid.uuid4()) + '\n')
        try:
            agentic_service.cancel_start(root, sys.modules[__name__])
        except (OSError, ValueError, KeyError, TypeError, RuntimeError):
            # A corrupt auxiliary request must not prevent Stop. The new marker fences any restored old request.
            pass
    if process:
        descriptor = None
        try:
            # Linux pidfds retain the exact process across the identity check and signal.
            if hasattr(os, 'pidfd_open') and hasattr(signal, 'pidfd_send_signal'):
                descriptor = os.pidfd_open(process['pid'])
            if single(root, installation) != process:
                raise RuntimeError('Process identity changed before shutdown; no signal was sent.')
            if descriptor is not None:
                signal.pidfd_send_signal(descriptor, signal.SIGINT)
            else:
                os.kill(process['pid'], signal.SIGINT)
        except ProcessLookupError:
            pass
        finally:
            if descriptor is not None:
                os.close(descriptor)
        deadline = time.monotonic() + args.stop_timeout
        while True:
            current = single(root, installation)
            if not current:
                break
            if current != process:
                raise RuntimeError('A different process appeared during shutdown; it was left intact.')
            if time.monotonic() >= deadline:
                raise RuntimeError('Graceful shutdown timed out; no forced kill was sent. The process and data were left intact.')
            time.sleep(0.2)
    (root / 'process.json').unlink(missing_ok=True)
    print('Stopped. Automatic recovery is paused.' if intentional else 'Stopped for restart.')


def access(root, installation, opening=False):
    if installation['role'] != 'workspace':
        raise RuntimeError('Endpoints and transports are headless; use enrollment for private connection metadata.')
    process = single(root, installation)
    if not process or not health(root, installation):
        raise RuntimeError('Start this installation before opening its authenticated page.')
    run = read_json(root / 'run.json')
    if not re.fullmatch(r'app-\d{8}-\d{6}-[a-f0-9]{32}\.log', run.get('log', '')):
        raise RuntimeError('The startup log reference is invalid.')
    log = root / 'logs' / run['log']
    descriptor = os.open(str(log), os.O_RDONLY | os.O_NOFOLLOW)
    info = os.fstat(descriptor)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        os.close(descriptor)
        raise RuntimeError('The startup log must be an owner-only regular file.')
    with os.fdopen(descriptor, 'r', encoding='utf8', errors='replace') as stream:
        prefix = stream.read(65536)
    urls = re.findall(r'http://127\.0\.0\.1:\d+/\?token=[A-Za-z0-9_%~.\-]+', prefix)
    matches = [url for url in urls if urllib.parse.urlsplit(url).port == installation['port']]
    if not matches:
        raise RuntimeError('No authenticated access link was found in the private startup log.')
    url = matches[-1]
    shortcut = root / 'Open Agentic OS.html'
    atomic(shortcut, '<!doctype html><html lang="en"><meta charset="utf-8"><title>Open Agentic OS</title>'
           '<meta name="referrer" content="no-referrer"><p><a rel="noreferrer" href="' + html.escape(url, quote=True)
           + '">Open Agentic OS</a></p></html>\n')
    if opening and not webbrowser.open(url):
        raise RuntimeError('No browser could be opened. Use the private shortcut: ' + str(shortcut))
    print(json.dumps({'shortcut': str(shortcut), 'opened': opening}))
    return 0


def main():
    default = Path.home() / 'Library' / 'Application Support' / 'Agentic OS' if sys.platform == 'darwin' else Path(os.environ.get('XDG_DATA_HOME', str(Path.home() / '.local' / 'share'))) / 'agentic-os'
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('init', 'start', 'status', 'stop', 'restart', 'access', 'open', 'enrollment',
                                         'supervise', 'service-install', 'service-status', 'service-remove'))
    parser.add_argument('--directory', help='Private installation directory; defaults to your persistent application-data folder.')
    parser.add_argument('--role', choices=('workspace', 'endpoint', 'transport'), help='Select the workspace, Linux endpoint or SSH transport role and default directory.')
    parser.add_argument('--transport-config', help='init only: private JSON with SSH host/account, identity, known hosts, endpoint enrollment and local credential-file paths.')
    parser.add_argument('--endpoint-config', help='init only: private JSON file containing endpoint limits and optional ownership binding.')
    parser.add_argument('--service-resources', help='init only: pool/command resource-budget JSON for an owned Linux systemd endpoint service.')
    parser.add_argument('--checkout', help='init only: built checkout to install; defaults to this checkout.')
    parser.add_argument('--dsh', help='init only: existing pinned Harness CLI; otherwise install it privately.')
    parser.add_argument('--profile', help='init only: Harness profile name (default agentic-os or agentic-endpoint).')
    parser.add_argument('--port', type=int, help='init only: loopback port (default workspace 3083, endpoint 3084, transport 3085).')
    parser.add_argument('--timeout', type=float, default=60, help='Startup health timeout in seconds; expiry never kills the process.')
    parser.add_argument('--stop-timeout', type=float, default=300, help='Graceful stop timeout in seconds; never force-kill.')
    parser.add_argument('--respect-stop', action='store_true', help='start/restart: honor an intentional stop marker.')
    parser.add_argument('--restart-delay', type=float, default=10, help='supervise/service-install: minimum seconds between automatic starts (default 10).')
    parser.add_argument('--restart-limit', type=int, default=5, help='supervise/service-install: maximum automatic starts per window (default 5).')
    parser.add_argument('--restart-window', type=float, default=600, help='supervise/service-install: rolling start budget in seconds (default 600).')
    args = parser.parse_args()
    if args.action != 'init' and any(value is not None for value in (args.checkout, args.dsh, args.profile, args.port, args.endpoint_config, args.service_resources, args.transport_config)):
        parser.error('Installation settings apply only to init; use --directory to select an existing installation.')
    if not 0 < args.timeout <= 3600 or not 0 < args.stop_timeout <= 3600:
        parser.error('Timeouts must be positive and at most 3600 seconds.')
    if not 0.1 <= args.restart_delay <= 3600 or not 1 <= args.restart_limit <= 20 or not 1 <= args.restart_window <= 86400:
        parser.error('Restart delay must be 0.1–3600 seconds, limit 1–20, and window 1–86400 seconds.')
    if args.role == 'endpoint':
        default = default.with_name(default.name + (' Endpoint' if sys.platform == 'darwin' else '-endpoint'))
        if args.action == 'init':
            agentic_endpoint.require_host()
    elif args.role == 'transport':
        default = default.with_name(default.name + (' Transport' if sys.platform == 'darwin' else '-transport'))
    root = Path(args.directory or default).expanduser()
    if not root.is_absolute() or '\n' in str(root) or '\r' in str(root) or root.is_symlink():
        parser.error('--directory must be an absolute non-symlink path without newlines.')
    root = root.resolve()
    if args.role == 'endpoint':
        agentic_endpoint.validate_directory(root)
    os.umask(0o077)
    private_directory(root)
    if args.action == 'status':
        installation = manifest(root)
        if args.role and args.role != installation['role']:
            raise RuntimeError('The selected installation has a different role; it was not changed.')
        return status(root, installation)
    if args.action == 'supervise' or args.action.startswith('service-'):
        installation = manifest(root)
        if args.role and args.role != installation['role']:
            raise RuntimeError('The selected installation has a different role; it was not changed.')
        api = sys.modules[__name__]
        if args.action == 'supervise':
            return agentic_service.supervise(root, args, api)
        return agentic_service.manage(root, args, api)
    if args.action in ('start', 'restart') and manifest(root).get('delegation'):
        return agentic_service.request_start(root, args, sys.modules[__name__])
    with operation(root):
        if args.action == 'init':
            return initialize(root, args)
        installation = manifest(root)
        if args.role and args.role != installation['role']:
            raise RuntimeError('The selected installation has a different role; it was not changed.')
        if args.action == 'enrollment':
            if installation['role'] not in ('endpoint', 'transport'):
                raise RuntimeError('Enrollment details are only available for endpoints and transports.')
            if not single(root, installation):
                raise RuntimeError('Start this endpoint before exporting enrollment details.')
            module = agentic_transport if installation['role'] == 'transport' else agentic_endpoint
            value = module.enrollment(root, installation, health(root, installation))
            target = root / 'enrollment.json'
            save(target, value)
            print(json.dumps({'file': str(target), **value}))
            return 0
        if args.action in ('access', 'open'):
            return access(root, installation, args.action == 'open')
        if args.respect_stop and args.action in ('start', 'restart') and (root / 'manually-stopped').exists():
            print('Intentional stop is active; automatic recovery skipped.')
            return 0
        if args.action in ('stop', 'restart'):
            stop(root, installation, args, args.action == 'stop')
        if args.action in ('start', 'restart'):
            result = launch(root, installation, args)
            if not args.respect_stop:
                agentic_service.reset(root, sys.modules[__name__])
            return result
        return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print('Operation interrupted. Check status before retrying.', file=sys.stderr)
        sys.exit(130)
    except (OSError, ValueError, KeyError, TypeError, RuntimeError, subprocess.CalledProcessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
